<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Scanning for the paired device (never for location: with this flag
         Android 12+ needs no location permission) and connecting to it. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The reading service runs in the foreground while it talks to the device
         (type connectedDevice; Android 14+ requires the typed permission and,
         as its prerequisite, the granted BLUETOOTH_CONNECT). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The reading summary and the problem notifications (Android 13+ asks at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The CPU stays up for the length of one reception (screen off). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The background scan is registered again after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- What is written to Health Connect; the user grants each in its dialog. -->
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Health Connect as an app (Android 12 and 13; built into 14+). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".HealthDevicesApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthDevices">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect shows this when the user asks why the app wants to
             write health data: Android 13 and lower through the Health Connect
             app's action, Android 14+ through the alias below. Health Connect
             refuses to ask for permissions for an app without it. -->
        <activity
            android:name=".ui.RationaleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.HealthDevices.Translucent"
            android:label="@string/rationale_title">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".ui.PermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.RationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- The background scan's matches arrive here through the app's own
             PendingIntent; nothing else may send to it. -->
        <receiver
            android:name=".ble.ScanResultReceiver"
            android:exported="false" />

        <!-- System events after which the scan must be registered again. The
             system sends these, so the receiver is exported with their filters;
             the receiver ignores any other action. -->
        <receiver
            android:name=".ble.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- One reception: connect, collect, write, notify, stop. -->
        <service
            android:name=".service.ReadingService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
